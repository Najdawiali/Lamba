{
  "name": "lamba-workspace",
  "version": "1.0.0",
  "description": "Lamba Workspace - Root Orchestrator for Mobile & Backend",
  "private": true,
  "scripts": {
    "services:up": "docker compose up -d postgres",
    "services:down": "docker compose down",
    "backend:up": "docker compose up -d",
    "backend:seed": "docker compose exec api python -m app.seed",
    "backend:logs": "docker compose logs -f api",
    "mobile:start": "node scripts/start-mobile.js",
    "mobile:tunnel": "node scripts/start-mobile.js --tunnel"
  }
}
