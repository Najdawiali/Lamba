# PostgreSQL
DATABASE_URL=postgresql+asyncpg://eagle:eagle_secret@postgres:5432/eagle_vision

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=products

# JWT
JWT_SECRET=change-me-to-a-real-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# CLIP Model (image search — disabled in text-only phase)
CLIP_MODEL_NAME=clip-ViT-B-32
ENABLE_IMAGE_SEARCH=false

# Embedding / Reranker provider ("deepinfra" or "local")
EMBEDDING_PROVIDER=deepinfra
DEEPINFRA_API_KEY=ro-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPINFRA_API_BASE=https://api.deepinfra.com/v1
EMBEDDING_REQUEST_TIMEOUT_SEC=15
EMBEDDING_MAX_RETRIES=2

# Qwen3 Text Encoder (multilingual, Arabic-strong)
QWEN_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
TEXT_EMBEDDING_DIM=1024
# Only used when EMBEDDING_PROVIDER=local:
QWEN_EMBED_DEVICE=cuda
QWEN_EMBED_DTYPE=float16

# Query embedding cache
EMBEDDING_CACHE_SIZE=256
EMBEDDING_CACHE_TTL_SEC=300

# Qwen3 Re-ranker (cross-encoder, instruction-aware)
ENABLE_RERANKER=true
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
# Only used when EMBEDDING_PROVIDER=local:
RERANKER_DEVICE=cuda
RERANKER_TOP_K=30
RERANKER_FINAL_K=15
RERANKER_INSTRUCTION=Given a customer search query in Arabic, Arabizi, or mixed Arabic/English, retrieve retail products sold by nearby shops.
RERANKER_MAX_LENGTH=8192

# Search
DEFAULT_SEARCH_RADIUS_KM=5.0
MAX_SEARCH_RESULTS=50

# Uploads
UPLOAD_DIR=./uploads
