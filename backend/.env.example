# PostgreSQL
DATABASE_URL=postgresql+asyncpg://eagle:eagle_secret@postgres:5432/eagle_vision

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=products

# JWT
JWT_SECRET=change-me-to-a-real-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# CLIP Model
CLIP_MODEL_NAME=clip-ViT-B-32

# Search
DEFAULT_SEARCH_RADIUS_KM=5.0
MAX_SEARCH_RESULTS=50

# Uploads
UPLOAD_DIR=./uploads
