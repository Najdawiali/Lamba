# PostgreSQL
DATABASE_URL=postgresql+asyncpg://eagle:eagle_secret@postgres:5432/eagle_vision

# JWT
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
# Sessions with refresh tokens (apps that send client_supports_refresh)
ACCESS_TOKEN_MINUTES=30
REFRESH_IDLE_DAYS=30
REFRESH_ABSOLUTE_DAYS=90
REFRESH_REUSE_LEEWAY_SECONDS=10

# CLIP Model (image search — disabled in text-only phase)
CLIP_MODEL_NAME=clip-ViT-B-32
ENABLE_IMAGE_SEARCH=false

# Embedding & Reranker Providers (local-only, no API key required)
EMBEDDING_PROVIDER=deepinfra
RERANKER_PROVIDER=deepinfra
DEEPINFRA_API_KEY=REPLACE_WITH_REAL_KEY
DEEPINFRA_API_BASE=https://api.deepinfra.com/v1

# Qwen3 Local Text Encoder (Primary: 0.6B — 1024-d)
QWEN_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
TEXT_EMBEDDING_DIM=1024

# Alternative 4B configuration (Future upgrade):
# QWEN_EMBED_MODEL=Qwen/Qwen3-Embedding-4B
# TEXT_EMBEDDING_DIM=2560

LOCAL_EMBED_DEVICE=auto
LOCAL_EMBED_MAX_LENGTH=512
LOCAL_EMBED_BATCH_SIZE=8
LOCAL_EMBED_NORMALIZE=true

# Embedding Cache
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_BACKEND=memory
EMBEDDING_CACHE_SIZE=2048
EMBEDDING_CACHE_TTL_SEC=3600

# Qwen3 Local Re-ranker (0.6B)
ENABLE_RERANKER=true
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
LOCAL_RERANK_DEVICE=auto
LOCAL_RERANK_MAX_LENGTH=512
LOCAL_RERANK_BATCH_SIZE=16
RERANKER_TOP_K=30
RERANKER_FINAL_K=15
RERANKER_WEIGHT=0.7
PRIOR_WEIGHT=0.3
RERANKER_STRICT_MODE=false
RERANKER_FALLBACK_TO_FUSION=true
RERANKER_SCORE_NORMALIZATION=auto

RERANKER_INSTRUCTION=Classify whether the document belongs to the same product category and type as the query. Variants like different colors or flavors of the same product are relevant.
RERANKER_INSTRUCTION_ENABLED=true
EMBEDDING_MAX_RETRIES=3

# Post-rerank guards
RERANKER_SCORE_GAP_THRESHOLD=0.15
RERANKER_TOKEN_OVERLAP_MIN=1
RERANKER_MIN_KEEP_SCORE=0.50
RERANKER_STRONG_CONFIDENCE=0.85

# Query Expansion (Disabled for local-only pass)
ENABLE_QUERY_EXPANSION=false
EXPANSION_PROVIDER=disabled

# LLM Models (Real-time search & Offline enrichment)
QUERY_LLM_MODEL=Qwen/Qwen3.6-35B-A3B
QUERY_LLM_FALLBACK_MODEL=Qwen/Qwen2.5-7B-Instruct
OFFLINE_LLM_MODEL=google/gemma-4-31B-it

# Search
DEFAULT_SEARCH_RADIUS_KM=5.0
MAX_SEARCH_RESULTS=50

# Uploads
UPLOAD_DIR=./uploads

# ── Email ────────────────────────────────────────
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM=Lamba <noreply@lambajo.com>

# ── Storage Backend ──────────────────────────────
# "local" for development, "r2" for production (Cloudflare R2)
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lamba-images
R2_PUBLIC_URL=
