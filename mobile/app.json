{
  "expo": {
    "name": "Lamba",
    "slug": "lamba",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lamba",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0A0A1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lamba.app",
      "config": {
        "googleMapsApiKey": "AIzaSyBE961k1OZH9eyXXuPbwCrr3aGulb_pWIo"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Lamba needs camera access for visual product search",
        "NSLocationWhenInUseUsageDescription": "Lamba needs your location to find nearby shops"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A1A"
      },
      "package": "com.lamba.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBE961k1OZH9eyXXuPbwCrr3aGulb_pWIo"
        }
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-camera",
      "expo-image-picker",
      "expo-location",
      "expo-secure-store",
      "expo-asset",
      "expo-localization"
    ],
    "locales": {
      "en": "./locales/en.json",
      "ar": "./locales/ar.json"
    },
    "extra": {
      "I18nManager": {
        "allowRTL": true,
        "forceRTL": false
      },
      "router": {},
      "eas": {
        "projectId": "c2916c19-6751-44fc-a8ac-669686ac2b97"
      }
    }
  }
}
